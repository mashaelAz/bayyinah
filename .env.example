# مزوّد البيانات الحديثية: auto | dorar | demo
#   auto  = يحاول الدرر السنية مباشرة، وإذا تعذر الوصول يستخدم النسخة المخزنة الموثقة (data/hadiths.json)
#   dorar = الدرر السنية فقط (يظهر خطأ واضح إذا تعذر الوصول، ولا تصدر نتيجة غير موثقة)
#   demo  = البيانات التجريبية الموثقة فقط
HADITH_PROVIDER=auto

# الواجهة العامة للموسوعة الحديثية في الدرر السنية
DORAR_API_URL=https://dorar.net/dorar_api.json

# محجوز لمفتاح رسمي إن أصدرت الدرر السنية واجهة بمفتاح. غير مستخدم حاليًا.
DORAR_API_KEY=

# اختياري: نموذج لغوي يساعد في فهم النص وفصل الحديث عن العبارات الإضافية.
# لا يُستخدم أبدًا لإصدار حكم على الحديث. إذا تُرك فارغًا يعمل النظام بالقواعد اللغوية فقط.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
